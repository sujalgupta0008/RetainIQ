# Copy to backend/.env or project root .env (never commit the real file)
DATABASE_URL=sqlite:///./retainiq.db
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 bytes (64 hex chars) for HS256. The app REFUSES to start in
# RETAINIQ_ENV=prod with the dev default below.
JWT_SECRET=change-me-to-a-long-random-string-min-64-hex-chars
CORS_ORIGINS=http://localhost:3000
SEED=42
RETAINIQ_ENV=dev
# Optional AI providers (app works without them via deterministic fallback).
# WARNING: when set, aggregate customer data is sent to the provider per request.
GEMINI_API_KEY=
OPENAI_API_KEY=

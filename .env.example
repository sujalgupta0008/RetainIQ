# Copy to backend/.env or project root .env (never commit the real file)
DATABASE_URL=sqlite:///./retainiq.db
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 chars for HS256. The app REFUSES to start in
# RETAINIQ_ENV=prod with a placeholder or short secret.
JWT_SECRET=change-me-generate-a-64-hex-char-secret-with-secrets-token_hex-32
CORS_ORIGINS=http://localhost:3000
SEED=42
RETAINIQ_ENV=dev
# Backend port (Docker/Render/HF use PORT; uvicorn default 8000).
PORT=8000
# Optional Google sign-in (backend). Leave empty to disable Google and use
# email + one-click demo login. When set, must match the frontend client ID.
GOOGLE_CLIENT_ID=
# Frontend API URL (used by Docker/Vercel builds; local dev defaults to localhost).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional AI providers (app works without them via deterministic fallback).
# WARNING: when set, aggregate customer data is sent to the provider per request.
GEMINI_API_KEY=
OPENAI_API_KEY=
